FROM python:3.12.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    ONETECH_AO_PROJECT_ROOT=/app \
    ONETECH_AO_ALLOW_ENV_ONLY=true

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libreoffice-writer \
        poppler-utils \
        tesseract-ocr \
        tesseract-ocr-ara \
        tesseract-ocr-eng \
        tesseract-ocr-fra \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
RUN python -m pip install --no-cache-dir . \
    "fastapi==0.116.1" \
    "httpx==0.28.1" \
    "uvicorn==0.35.0" \
    && useradd --create-home --uid 10001 worker

COPY automation/prompts/ ./automation/prompts/
COPY config/ ./config/

USER worker
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3).read()"]

CMD ["uvicorn", "onetech_ao.worker:app", "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]
